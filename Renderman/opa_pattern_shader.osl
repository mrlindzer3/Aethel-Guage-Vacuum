shader opa_pattern_shader(
    point P = P,
    float SteeringAngle = 0.2618, // ~15 degrees in radians
    float Wavelength = 0.55,      // 550nm green light
    output color ResultColor = 0,
    output float PhaseOut = 0
)
{
    // Wave number calculation
    float k = 6.28318530718 / Wavelength;
    
    // Spatial projection along the steering vector (using X coordinate)
    float spatial_projection = P[0] * sin(SteeringAngle);
    
    // Compute wrapped phase delay [0, 2*pi]
    float phase_delay = mod(k * spatial_projection, 6.28318530718);
    PhaseOut = phase_delay;
    
    // Generate an optical interference color fringe using phase offset
    ResultColor = color(
        sin(phase_delay + 0.0),
        sin(phase_delay + 2.094),
        sin(phase_delay + 4.188)
    ) * 0.5 + 0.5;
}
